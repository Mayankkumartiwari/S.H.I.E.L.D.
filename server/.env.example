PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/shield
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
AIML_SERVICE_URL=http://localhost:8000

# Configure an HTTPS webhook that accepts { email, code, expiresInMinutes } before production.
OTP_DELIVERY_URL=
OTP_DELIVERY_TOKEN=

# Optional first administrator account. Use a unique, strong password and keep it out of source control.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Campus Administrator
BOOTSTRAP_ADMIN_DEPARTMENT=Student Affairs
BOOTSTRAP_ADMIN_STUDENT_ID=administrator
